{
  "name": "zella",
  "version": "0.1.0",
  "description": "Seller-first residential real estate platform: listings, open houses and buyer lead management.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/preview/build-fixtures.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "fixtures:restore": "tsx scripts/db/restore-dev-fixtures.ts",
    "admin:grant": "tsx scripts/ops/grant-admin.ts",
    "demo:plan": "tsx scripts/demo/cli.ts plan",
    "demo:seed": "tsx scripts/demo/cli.ts seed",
    "demo:refresh-dates": "tsx scripts/demo/cli.ts refresh-dates",
    "demo:visibility": "tsx scripts/demo/cli.ts visibility",
    "demo:remove": "tsx scripts/demo/cli.ts remove",
    "demo:storage-retry": "tsx scripts/demo/cli.ts storage-retry",
    "demo:import-images": "tsx scripts/demo/import-images.ts",
    "demo:contact-sheet": "tsx scripts/demo/contact-sheet.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "preview:fixtures": "tsx scripts/preview/build-fixtures.ts --force"
  },
  "dependencies": {
    "@date-fns/tz": "^1.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "resend": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "supabase": "^2.2.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
