# ── Supabase (LOCAL stack: `npx supabase start`, values from `npx supabase status`) ──
# Development never points at the hosted project; see docs/architecture.md.
# Public — safe for the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used for admin operations
# (auth.admin.*, storage signed URLs, bypassing RLS in server actions).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to "fixtures" to run read-only on the public demo dataset with no
# backend (what Vercel previews do automatically).
NEXT_PUBLIC_DATA_MODE=

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secret used to salt/hash IPs for rate limiting so raw IPs are
# never stored. Any long random string.
RATE_LIMIT_IP_SALT=change-me-to-a-random-string

# ── Email (Resend) ───────────────────────────────────────────────────────
# Optional in development: when unset, emails render to ./.dev-emails/*.html
# instead of sending, and are logged in email_deliveries as sent (dev:*).
RESEND_API_KEY=
RESEND_FROM_EMAIL="Zella <notifications@yourdomain.com>"

# ── Bot protection (Cloudflare Turnstile) ───────────────────────────────
# Optional in development: when unset, Turnstile verification is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Local fixtures only ─────────────────────────────────────────────────
# Password for the local development fixture accounts. Leave empty to have
# `npm run fixtures:restore` generate one. Never set this in Vercel.
SEED_USER_PASSWORD=
