# Operator-only credentials for production data scripts (demo:*, fixtures:hosted-*,
# admin:grant). Copy to .env.production-ops.local (gitignored). Next.js never
# loads this file, and it must never be added to Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_SERVICE_ROLE_KEY=
